<?xml version="1.0" encoding="utf-8"?>
<!-- Only playlists/favourites database and preferences are backed up; never audio files. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sonora.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sonora.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
